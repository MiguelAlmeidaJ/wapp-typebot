server {
  server_name atendimento.skynetfibra.net.br;

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_cache_bypass $http_upgrade;
  }



    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/atendimento.skynetfibra.net.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/atendimento.skynetfibra.net.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = atendimento.skynetfibra.net.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


  server_name atendimento.skynetfibra.net.br;
    listen 80;
    return 404; # managed by Certbot


