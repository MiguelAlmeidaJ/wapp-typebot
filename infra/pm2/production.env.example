# Wapp PM2 production environment
# Create infra/pm2/production.env with: pnpm prod:init
# prod:init generates JWT_SECRET, METRICS_TOKEN and EVOLUTION_WEBHOOK_SECRET.
# Never commit production.env.

NODE_ENV=production
# Default: bind API and Web to loopback and expose only the reverse proxy.
# If Dockerized Evolution/Typebot/proxy containers must reach Wapp through the
# host gateway, use the specific private Docker host-gateway address instead
# (for example 172.17.0.1). Never use 0.0.0.0 in production.
HOST=127.0.0.1
PORT=4401
WEB_PORT=3301
WEB_HOST=127.0.0.1
WEB_URL=https://CHANGE_ME.example.com
NEXT_PUBLIC_API_URL=https://CHANGE_ME.example.com
# When HOST is a private Docker/host address, API_INTERNAL_URL must use the same
# address and PORT so server-side Web requests can reach the API.
API_INTERNAL_URL=http://127.0.0.1:4401
TRUST_PROXY=true
API_BODY_MAX_BYTES=1048576

# Keep the TLS query parameters because Prisma CLI uses these URLs directly
# during migrate deploy. The API runtime also validates DATABASE_TLS_CA_PATH.
# URL-encode special characters in database passwords (for example @ -> %40).
DATABASE_URL=mysql://wapp:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:3306/wapp?sslcert=/etc/wapp/mysql/ca.pem&sslaccept=strict
SHADOW_DATABASE_URL=mysql://wapp:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:3306/wapp_shadow?sslcert=/etc/wapp/mysql/ca.pem&sslaccept=strict
DATABASE_TLS_CA_PATH=/etc/wapp/mysql/ca.pem

REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0

JOBS_EMBEDDED_WORKER=false
JOBS_MEDIA_CAPTURE_CONCURRENCY=4
JOBS_MEDIA_CAPTURE_ATTEMPTS=5

# These three values are replaced with cryptographically random secrets by prod:init.
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
METRICS_TOKEN=CHANGE_ME_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true

EVOLUTION_BASE_URL=https://CHANGE_ME_EVOLUTION_HOST
EVOLUTION_API_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS
EVOLUTION_WEBHOOK_BASE_URL=https://CHANGE_ME.example.com
EVOLUTION_WEBHOOK_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
EVOLUTION_HEALTHCHECK_INTERVAL_SECONDS=60

# On a single-host PM2 deployment, local media is supported because API and
# worker share the same filesystem. Use an absolute path outside the repo.
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_PATH=/var/lib/wapp/media
MEDIA_MAX_BYTES=26214400

# S3-compatible storage. Required only when MEDIA_STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

TYPEBOT_URL=
TYPEBOT_ENABLED=false
TYPEBOT_API_URL=
TYPEBOT_API_TOKEN=
TYPEBOT_WEBHOOK_SECRET=
TYPEBOT_REQUEST_TIMEOUT_MS=15000

MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_HOURS=6
SESSION_RETENTION_DAYS=30
MAINTENANCE_STALE_MEDIA_MINUTES=30
