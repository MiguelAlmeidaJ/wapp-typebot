server {

	root /home/deploy/dct/financeiro;
	index index.html index.htm index.nginx-debian.html index.php;
	server_name financeiro.skynetfibra.net.br;
	location / {
		try_files $uri $uri/ =404;
	}

	location ~ \.php$ {
		include snippets/fastcgi-php.conf;
		fastcgi_pass unix:/run/php/php7.4-fpm.sock;
	}

	location ~ /\.ht {
		deny all;
	}




    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/financeiro.skynetfibra.net.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/financeiro.skynetfibra.net.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}server {
    if ($host = financeiro.skynetfibra.net.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


}
